FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml ./
COPY api ./api
COPY packages ./packages
COPY infra ./infra
COPY data ./data

RUN pip install --no-cache-dir \
    "alembic>=1.13,<2" \
    "asyncpg>=0.29,<1" \
    "celery[redis]>=5.4,<6" \
    "fastapi>=0.115,<1" \
    "openpyxl>=3.1,<4" \
    "weasyprint>=63,<69" \
    "python-multipart>=0.0.9,<1" \
    "scikit-learn>=1.5,<2" \
    "sqlalchemy[asyncio]>=2.0,<3" \
    "uvicorn[standard]>=0.30,<1"

ENV PYTHONPATH=/app

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
