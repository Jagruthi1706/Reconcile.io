# ============================================================================
# RECONCILE.IO ENVIRONMENT VARIABLES
# ============================================================================
# PRODUCTION vs LOCAL:
#   - LOCAL DEV: Use .env (git-ignored, copy from .env.example)
#   - PRODUCTION: Set in Railway/Vercel dashboards (never commit secrets)
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# APPLICATION ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────
APP_ENV=development
API_PORT=8000
WEB_PORT=3000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be different for each environment
JWT_SECRET=change-me-in-dev-too

# ─────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────
# LOCAL: postgresql+asyncpg://afc:afc@localhost:5432/afc
# RAILWAY: Automatically set, do NOT modify
DATABASE_URL=postgresql+asyncpg://afc:afc@localhost:5432/afc

# ─────────────────────────────────────────────────────────────────────────
# CACHE & MESSAGE BROKER (Redis)
# ─────────────────────────────────────────────────────────────────────────
# LOCAL: redis://localhost:6379/0
# RAILWAY: Automatically set, do NOT modify
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────
# RAZORPAY (TEST MODE ONLY — never use live keys)
# ─────────────────────────────────────────────────────────────────────────
# Mode is HARDCODED to "test" — production will refuse to boot otherwise
RAZORPAY_MODE=test

# From Razorpay Dashboard → Settings → API Keys (Test Key)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# From Razorpay Dashboard → Settings → Webhooks (after creating webhook)
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────
# FRONTEND (CORS & API Base URL)
# ─────────────────────────────────────────────────────────────────────────
# LOCAL: http://localhost:3000
# PRODUCTION RAILWAY: https://api-xxxx.railway.app/api/v1
# PRODUCTION VERCEL (frontend): https://web-xxxx.vercel.app
CORS_ORIGINS=http://localhost:3000

# Frontend-visible (not secret)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ─────────────────────────────────────────────────────────────────────────
# ANTHROPIC API (OPTIONAL — Copilot without it uses structured-only mode)
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────────────────
# GEMINI API (OPTIONAL — Alternative LLM provider)
# ─────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────────────────────
# MATCHING ENGINE TUNING (Editable from Settings page after deployment)
# ─────────────────────────────────────────────────────────────────────────
MATCH_AUTO_ACCEPT_CONFIDENCE=0.90
MATCH_AMOUNT_TOLERANCE_PCT=1.5
MATCH_DATE_WINDOW_DAYS=5
